# Copy to .env (gitignored) for `npm run docker:api`.
# Every request needs the header X-DevPath-Token with this value. Use a long random string, e.g. in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
DEVPATH_TOKEN=
DEVPATH_PORT=5180
