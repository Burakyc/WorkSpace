{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpath.local/schemas/post.schema.json",
  "title": "DevPath post draft import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "topic",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "post"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "hashtags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 51,
              "pattern": "^#?[^\\s#]+$"
            }
          },
          "sourceLink": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://[^\\s]+$"
          },
          "imageSuggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
