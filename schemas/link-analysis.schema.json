{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpath.local/schemas/link-analysis.schema.json",
  "title": "DevPath link analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "topic",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "link-analysis"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "source",
          "title",
          "note"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://[^\\s]+$"
          },
          "source": {
            "enum": [
              "youtube",
              "page"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
